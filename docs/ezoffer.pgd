<?xml version="1.0" encoding="UTF-8"?>
<pgd version="1" pg-version="18" default-schema="public">
  <project name="ezoffer">
    <settings>
      <naming convention="camelCase"></naming>
      <defaults nullable="true" on-delete="restrict" on-update="restrict"></defaults>
    </settings>
  </project>
  <roles></roles>
  <tablespaces></tablespaces>
  <extensions></extensions>
  <sequences></sequences>
  <schema name="public">
    <table name="comments">
      <column name="commentId" type="bigint" nullable="false"><identity generated="by default"></identity></column>
      <column name="content" type="text" nullable="false"></column>
      <column name="likesCnt" type="bigint" nullable="false" default="0"></column>
      <column name="userId" type="bigint"></column>
      <column name="isVisible" type="boolean" nullable="false" default="true"></column>
      <column name="createdAt" type="timestamptz" nullable="false" default="now()"></column>
      <column name="interviewId" type="bigint"></column>
      <column name="questionId" type="bigint"></column>
      <column name="testAssignmentId" type="bigint"></column>
      <column name="taskId" type="bigint"></column>
      <pk name="pk_comments">
        <column name="commentId"></column>
      </pk>
      <fk name="fk_comments_interviewId" to-table="interviews" on-delete="cascade" on-update="restrict">
        <column name="interviewId" references="interviewId"></column>
      </fk>
      <fk name="fk_comments_questionId" to-table="questions" on-delete="cascade" on-update="restrict">
        <column name="questionId" references="questionId"></column>
      </fk>
      <fk name="fk_comments_taskId" to-table="tasks" on-delete="cascade" on-update="restrict">
        <column name="taskId" references="taskId"></column>
      </fk>
      <fk name="fk_comments_testAssignmentId" to-table="testAssignments" on-delete="cascade" on-update="restrict">
        <column name="testAssignmentId" references="testAssignmentId"></column>
      </fk>
      <fk name="fk_comments_userId" to-table="users" on-delete="restrict" on-update="restrict">
        <column name="userId" references="userId"></column>
      </fk>
      <check name="chk_comments_oneEntity"><![CDATA[(("interviewId" IS NOT NULL)::int + ("questionId" IS NOT NULL)::int + ("testAssignmentId" IS NOT NULL)::int + ("taskId" IS NOT NULL)::int) = 1]]></check>
      <check name="chk_comments_likesCnt"><![CDATA["likesCnt" >= 0]]></check>
    </table>
    <table name="companies">
      <column name="companyId" type="bigint" nullable="false"><identity generated="by default"></identity></column>
      <column name="name" type="varchar" length="255" nullable="false"></column>
      <pk name="pk_companies">
        <column name="companyId"></column>
      </pk>
      <unique name="">
        <column name="name"></column>
      </unique>
    </table>
    <table name="interviews">
      <column name="interviewId" type="bigint" nullable="false"><identity generated="by default"></identity></column>
      <column name="sourceId" type="bigint"></column>
      <column name="slug" type="varchar" length="255" nullable="false"></column>
      <column name="title" type="varchar" length="255" nullable="false"></column>
      <column name="grades" type="varchar[]" nullable="false" default="'{}'"></column>
      <column name="types" type="varchar[]" nullable="false" default="'{}'"></column>
      <column name="companyId" type="bigint"></column>
      <column name="youtubeUrl" type="text"></column>
      <column name="vfsPath" type="text"></column>
      <column name="sourceUrl" type="text"></column>
      <column name="isEmbeddable" type="boolean" nullable="false" default="false"></column>
      <column name="isReal" type="boolean" nullable="false" default="true"></column>
      <column name="isVisible" type="boolean" nullable="false" default="true"></column>
      <column name="publishedDate" type="date"></column>
      <column name="createdAt" type="timestamptz" nullable="false" default="now()"></column>
      <pk name="pk_interviews">
        <column name="interviewId"></column>
      </pk>
      <fk name="fk_interviews_companyId" to-table="companies" on-delete="restrict" on-update="restrict">
        <column name="companyId" references="companyId"></column>
      </fk>
      <unique name="">
        <column name="slug"></column>
      </unique>
      <unique name="">
        <column name="sourceId"></column>
      </unique>
      <check name="chk_interviews_grades"><![CDATA["grades" <@ ARRAY['junior','middle','senior','lead']::varchar[]]]></check>
      <check name="chk_interviews_types"><![CDATA["types" <@ ARRAY['technical','liveCoding','algorithmic','hrScreening','final','systemDesign']::varchar[]]]></check>
      <check name="chk_interviews_video"><![CDATA["youtubeUrl" IS NOT NULL OR "vfsPath" IS NOT NULL OR "sourceUrl" IS NOT NULL]]></check>
    </table>
    <table name="questions">
      <column name="questionId" type="bigint" nullable="false"><identity generated="by default"></identity></column>
      <column name="sourceId" type="bigint" nullable="false"></column>
      <column name="slug" type="varchar" length="255" nullable="false"></column>
      <column name="content" type="text" nullable="false"></column>
      <column name="frequency" type="real"></column>
      <column name="createdAt" type="timestamptz" nullable="false" default="now()"></column>
      <pk name="pk_questions">
        <column name="questionId"></column>
      </pk>
      <unique name="">
        <column name="slug"></column>
      </unique>
      <unique name="">
        <column name="sourceId"></column>
      </unique>
      <check name="chk_questions_frequency"><![CDATA["frequency" IS NULL OR ("frequency" >= 0 AND "frequency" <= 100)]]></check>
    </table>
    <table name="questionsGrades">
      <column name="questionId" type="bigint" nullable="false"></column>
      <column name="grade" type="varchar" length="20" nullable="false"></column>
      <column name="frequency" type="real" nullable="false"></column>
      <pk name="pk_questionsGrades">
        <column name="questionId"></column>
        <column name="grade"></column>
      </pk>
      <fk name="fk_questionsGrades_questionId" to-table="questions" on-delete="cascade" on-update="restrict">
        <column name="questionId" references="questionId"></column>
      </fk>
      <check name="chk_questionsGrades_grade"><![CDATA["grade" = ANY (ARRAY['junior','middle','senior','lead'])]]></check>
      <check name="chk_questionsGrades_frequency"><![CDATA["frequency" >= 0 AND "frequency" <= 100]]></check>
    </table>
    <table name="skills">
      <column name="skillId" type="bigint" nullable="false"><identity generated="by default"></identity></column>
      <column name="name" type="varchar" length="255" nullable="false"></column>
      <pk name="pk_skills">
        <column name="skillId"></column>
      </pk>
      <unique name="">
        <column name="name"></column>
      </unique>
    </table>
    <table name="tasks">
      <column name="taskId" type="bigint" nullable="false"><identity generated="by default"></identity></column>
      <column name="sourceId" type="bigint" nullable="false"></column>
      <column name="slug" type="varchar" length="255" nullable="false"></column>
      <column name="title" type="varchar" length="255" nullable="false"></column>
      <column name="grades" type="varchar[]" nullable="false" default="'{}'"></column>
      <column name="type" type="varchar" length="20"></column>
      <column name="content" type="text" nullable="false"></column>
      <column name="sourceUrl" type="text"></column>
      <column name="rank" type="integer"></column>
      <column name="lastDate" type="timestamptz"></column>
      <column name="createdAt" type="timestamptz" nullable="false" default="now()"></column>
      <pk name="pk_tasks">
        <column name="taskId"></column>
      </pk>
      <unique name="">
        <column name="slug"></column>
      </unique>
      <unique name="">
        <column name="sourceId"></column>
      </unique>
      <check name="chk_tasks_grades"><![CDATA["grades" <@ ARRAY['junior','middle','senior','lead']::varchar[]]]></check>
      <check name="chk_tasks_type"><![CDATA["type" IS NULL OR "type" = ANY (ARRAY['liveCoding','algorithms','systemDesign'])]]></check>
    </table>
    <table name="tasksCompanies">
      <column name="taskId" type="bigint" nullable="false"></column>
      <column name="companyId" type="bigint" nullable="false"></column>
      <pk name="pk_tasksCompanies">
        <column name="taskId"></column>
        <column name="companyId"></column>
      </pk>
      <fk name="fk_tasksCompanies_companyId" to-table="companies" on-delete="restrict" on-update="restrict">
        <column name="companyId" references="companyId"></column>
      </fk>
      <fk name="fk_tasksCompanies_taskId" to-table="tasks" on-delete="cascade" on-update="restrict">
        <column name="taskId" references="taskId"></column>
      </fk>
    </table>
    <table name="testAssignments">
      <column name="testAssignmentId" type="bigint" nullable="false"><identity generated="by default"></identity></column>
      <column name="slug" type="varchar" length="255" nullable="false"></column>
      <column name="title" type="varchar" length="255" nullable="false"></column>
      <column name="grades" type="varchar[]" nullable="false" default="'{}'"></column>
      <column name="content" type="text" nullable="false"></column>
      <column name="sourceUrl" type="text"></column>
      <column name="publishedDate" type="date"></column>
      <column name="createdAt" type="timestamptz" nullable="false" default="now()"></column>
      <pk name="pk_testAssignments">
        <column name="testAssignmentId"></column>
      </pk>
      <unique name="">
        <column name="slug"></column>
      </unique>
      <check name="chk_testAssignments_grades"><![CDATA["grades" <@ ARRAY['junior','middle','senior','lead']::varchar[]]]></check>
    </table>
    <table name="testAssignmentsCompanies">
      <column name="testAssignmentId" type="bigint" nullable="false"></column>
      <column name="companyId" type="bigint" nullable="false"></column>
      <pk name="pk_testAssignmentsCompanies">
        <column name="testAssignmentId"></column>
        <column name="companyId"></column>
      </pk>
      <fk name="fk_testAssignmentsCompanies_companyId" to-table="companies" on-delete="restrict" on-update="restrict">
        <column name="companyId" references="companyId"></column>
      </fk>
      <fk name="fk_testAssignmentsCompanies_testAssignmentId" to-table="testAssignments" on-delete="cascade" on-update="restrict">
        <column name="testAssignmentId" references="testAssignmentId"></column>
      </fk>
    </table>
    <table name="testAssignmentsSkills">
      <column name="testAssignmentId" type="bigint" nullable="false"></column>
      <column name="skillId" type="bigint" nullable="false"></column>
      <pk name="pk_testAssignmentsSkills">
        <column name="testAssignmentId"></column>
        <column name="skillId"></column>
      </pk>
      <fk name="fk_testAssignmentsSkills_skillId" to-table="skills" on-delete="restrict" on-update="restrict">
        <column name="skillId" references="skillId"></column>
      </fk>
      <fk name="fk_testAssignmentsSkills_testAssignmentId" to-table="testAssignments" on-delete="cascade" on-update="restrict">
        <column name="testAssignmentId" references="testAssignmentId"></column>
      </fk>
    </table>
    <table name="users">
      <column name="userId" type="bigint" nullable="false"><identity generated="by default"></identity></column>
      <column name="createdAt" type="timestamptz" nullable="false" default="now()"></column>
      <pk name="pk_users">
        <column name="userId"></column>
      </pk>
    </table>
    <index name="ix_comments_interviewId_createdAt" table="comments">
      <column name="interviewId"></column>
      <column name="createdAt" order="desc"></column>
    </index>
    <index name="ix_comments_questionId_createdAt" table="comments">
      <column name="questionId"></column>
      <column name="createdAt" order="desc"></column>
    </index>
    <index name="ix_comments_taskId_createdAt" table="comments">
      <column name="taskId"></column>
      <column name="createdAt" order="desc"></column>
    </index>
    <index name="ix_comments_testAssignmentId_createdAt" table="comments">
      <column name="testAssignmentId"></column>
      <column name="createdAt" order="desc"></column>
    </index>
    <index name="ix_comments_userId" table="comments">
      <column name="userId"></column>
    </index>
    <index name="ix_interviews_companyId" table="interviews">
      <column name="companyId"></column>
    </index>
    <index name="ix_interviews_grades" table="interviews" using="gin">
      <column name="grades"></column>
    </index>
    <index name="ix_interviews_types" table="interviews" using="gin">
      <column name="types"></column>
    </index>
    <index name="ix_questions_frequency" table="questions">
      <column name="frequency" order="desc"></column>
    </index>
    <index name="ix_questionsGrades_grade_frequency" table="questionsGrades">
      <column name="grade"></column>
      <column name="frequency" order="desc"></column>
    </index>
    <index name="ix_tasks_grades" table="tasks" using="gin">
      <column name="grades"></column>
    </index>
    <index name="ix_tasks_type" table="tasks">
      <column name="type"></column>
    </index>
    <index name="ix_tasks_rank" table="tasks">
      <column name="rank"></column>
    </index>
    <index name="ix_tasksCompanies_companyId" table="tasksCompanies">
      <column name="companyId"></column>
    </index>
    <index name="ix_tasksCompanies_taskId" table="tasksCompanies">
      <column name="taskId"></column>
    </index>
    <index name="ix_testAssignments_grades" table="testAssignments" using="gin">
      <column name="grades"></column>
    </index>
    <index name="ix_testAssignmentsCompanies_companyId" table="testAssignmentsCompanies">
      <column name="companyId"></column>
    </index>
    <index name="ix_testAssignmentsCompanies_testAssignmentId" table="testAssignmentsCompanies">
      <column name="testAssignmentId"></column>
    </index>
    <index name="ix_testAssignmentsSkills_skillId" table="testAssignmentsSkills">
      <column name="skillId"></column>
    </index>
    <index name="ix_testAssignmentsSkills_testAssignmentId" table="testAssignmentsSkills">
      <column name="testAssignmentId"></column>
    </index>
  </schema>
  <functions></functions>
  <triggers></triggers>
  <rules></rules>
  <policies></policies>
  <comments></comments>
  <layouts>
    <layout name="Default Diagram" default="true">
      <entity schema="public" table="comments" x="40" y="40"></entity>
      <entity schema="public" table="companies" x="420" y="40"></entity>
      <entity schema="public" table="interviews" x="920" y="-580"></entity>
      <entity schema="public" table="questions" x="1180" y="40"></entity>
      <entity schema="public" table="questionsGrades" x="1560" y="940"></entity>
      <entity schema="public" table="skills" x="1560" y="40"></entity>
      <entity schema="public" table="tasks" x="40" y="500"></entity>
      <entity schema="public" table="tasksCompanies" x="420" y="500"></entity>
      <entity schema="public" table="testAssignments" x="800" y="500"></entity>
      <entity schema="public" table="testAssignmentsCompanies" x="1180" y="500"></entity>
      <entity schema="public" table="testAssignmentsSkills" x="1560" y="500"></entity>
      <entity schema="public" table="users" x="40" y="940"></entity>
    </layout>
  </layouts>
</pgd>
